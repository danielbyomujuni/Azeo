SOURCES = \
	azeo.desktop \
	main.c \
	preloader.c \
	preloader_mac.c \
	wine.inf.in \
	wine_info.plist.in

PROGRAMS = $(WINELOADER_PROGRAMS)
INSTALL_LIB = $(WINELOADER_PROGRAMS)
UNIX_CFLAGS = -fPIE

preloader_EXTRADEFS = -fno-builtin

azeo_OBJS = main.o
azeo_DEPS = $(WINELOADER_DEPENDS)
azeo_LDFLAGS = $(WINELOADER_LDFLAGS) $(LDEXECFLAGS) $(PTHREAD_LIBS)

azeo_preloader_OBJS = preloader.o preloader_mac.o
azeo_preloader_DEPS = $(WINELOADER_DEPENDS)
azeo_preloader_LDFLAGS = $(WINEPRELOADER_LDFLAGS)
